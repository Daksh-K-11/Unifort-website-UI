# Public URL of the storefront (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Next.js server reaches the UNIFORT API. The browser never calls this
# directly: /api/v1/* and /uploads/* are proxied through the storefront origin,
# so session cookies stay first-party. In Docker / production use the internal URL,
# e.g. http://api:5000
API_INTERNAL_URL=http://localhost:5000

# Optional: enable Vercel Analytics (requires the site to be hosted on Vercel)
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
